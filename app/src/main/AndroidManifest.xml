<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== الصوت ===== -->
    <!-- البث المباشر عبر الميكروفون (اضغط للتحدث) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- تشغيل الوسائط في الخلفية (خدمة أمامية من نوع mediaPlayback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ===== الإشعارات ===== -->
    <!-- إشعار المشغل والإشعارات العامة (أندرويد 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== الجدولة الدقيقة ===== -->
    <!-- إعادة تهيئة المنبهات بعد إعادة تشغيل الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- منبهات دقيقة لبدء الفقرات في موعدها (API 31+، تُطلب من المستخدم في الإعدادات) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v0.13.0: منبهات دقيقة مضمونة تلقائياً على أندرويد 13/14+ — التطبيق خارج متجر
         Play (تثبيت مباشر للمدارس) فلا تخضع لمراجعة سياساته، وهذه وظيفته الجوهرية:
         إذاعة آلية في ثانية محددة. تلغي الحاجة للموافقة اليدوية على أندرويد الحديث. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- v0.13.0: طلب إعفاء من تحسينات البطارية — يمنع قتلة الخلفية عند المصنّعين
         من إسكات الأتمتة الإذاعية (يُطلب باقتراح مهذب من شاشة الجدولة) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- v0.14.0: تصدير التسجيلات إلى Downloads على أندرويد 9 وما قبله فقط —
         أندرويد 10+ يستخدم MediaStore بلا أي صلاحية -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".SchoolRadioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SchoolRadio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- خدمة الوسائط: تشغيل الصوت في الخلفية + إشعار بعناصر تحكم -->
        <service
            android:name=".audio.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- مستقبل المنبهات الدقيقة: يبدأ الفقرة المجدولة -->
        <receiver
            android:name=".scheduler.AlarmReceiver"
            android:exported="false" />

        <!-- v0.13.0: خدمة الأتمتة الحارسة — نبض دائم يضمن انطلاق الفقرات
             أوتوماتيكياً حتى لو انقلبت المنبهات (أجهزة تقتل الخلفية) -->
        <service
            android:name=".scheduler.AutomationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- v0.14.0: مزوّد الملفات — مشاركة التسجيلات عبر تطبيقات أخرى
             (واتساب/تيليغرام/البريد…) بمنح قراءة مؤقتة وآمنة لملف واحد فقط -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- إعادة تهيئة المنبهات بعد إعادة التشغيل / تغيّر الوقت / تحديث التطبيق -->
        <receiver
            android:name=".scheduler.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
